"""
Calibración de cámara: convierte coordenadas de píxel (dedo detectado
por el hand tracking) a coordenadas físicas en milímetros sobre la
lámina impresa en 3D.

Método: homografía a partir de 4 puntos de referencia conocidos
(las esquinas del área imprimible), medidos una sola vez con la cámara
ya montada en su posición final.
"""
import numpy as np
import cv2


class PixelToMMCalibrator:
    def __init__(self):
        self.homography = None;

    def calibrate(self, pixel_points, mm_points):
        """
        pixel_points: lista de 4 (x_px, y_px) vistos por la cámara.
        mm_points:    lista de 4 (x_mm, y_mm) reales, en el mismo orden.
                      Ej. para una lámina de 200x150 mm:
                      [(0,0), (200,0), (200,150), (0,150)]
                      (sup-izq, sup-der, inf-der, inf-izq)
        """
        src = np.array(pixel_points, dtype=np.float32)
        dst = np.array(mm_points, dtype=np.float32)
        self.homography, _ = cv2.findHomography(src, dst)

    def pixel_to_mm(self, x_px, y_px):
        if self.homography is None:
            raise RuntimeError("Calibra primero con calibrate()")
        point = np.array([[[x_px, y_px]]], dtype=np.float32)
        result = cv2.perspectiveTransform(point, self.homography)
        x_mm, y_mm = result[0][0]
        return float(x_mm), float(y_mm)

    def save(self, path):
        np.save(path, self.homography)

    def load(self, path):
        self.homography = np.load(path)

