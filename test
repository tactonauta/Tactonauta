"""
Prueba de MediaPipe Hands dentro de Codespaces, SIN cámara y SIN pantalla.

En vez de leer una cámara en vivo (imposible en un contenedor remoto),
procesa un archivo de video que tú subas al codespace, dibuja los
landmarks de la mano sobre cada frame, guarda un video anotado
(video_salida.mp4) y escribe en un CSV la posición en píxeles de la
punta del dedo índice en cada frame.

Uso:
    python test_hand_video.py mi_video.mp4
"""
import sys
import csv
import cv2
import mediapipe as mp

INDICE_PUNTA = 8  # id del landmark de la punta del dedo índice en MediaPipe Hands


def main(video_path):
    mp_hands = mp.solutions.hands
    mp_drawing = mp.solutions.drawing_utils

    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        print(f"No pude abrir el video: {video_path}")
        sys.exit(1)

    fps = cap.get(cv2.CAP_PROP_FPS) or 30
    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

    fourcc = cv2.VideoWriter_fourcc(*"mp4v")
    out = cv2.VideoWriter("video_salida.mp4", fourcc, fps, (width, height))

    csv_file = open("coordenadas_indice.csv", "w", newline="")
    writer = csv.writer(csv_file)
    writer.writerow(["frame", "x_px", "y_px"])

    frame_num = 0
    detecciones = 0

    with mp_hands.Hands(
        static_image_mode=False,
        max_num_hands=1,
        min_detection_confidence=0.5,
        min_tracking_confidence=0.5,
    ) as hands:
        while True:
            ok, frame = cap.read()
            if not ok:
                break

            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            resultado = hands.process(rgb)

            if resultado.multi_hand_landmarks:
                detecciones += 1
                mano = resultado.multi_hand_landmarks[0]
                mp_drawing.draw_landmarks(frame, mano, mp_hands.HAND_CONNECTIONS)

                punta = mano.landmark[INDICE_PUNTA]
                x_px = int(punta.x * width)
                y_px = int(punta.y * height)
                writer.writerow([frame_num, x_px, y_px])

                cv2.circle(frame, (x_px, y_px), 8, (0, 0, 255), -1)

            out.write(frame)
            frame_num += 1

    cap.release()
    out.release()
    csv_file.close()

    print(f"Listo. {frame_num} frames procesados, mano detectada en {detecciones}.")
    print("Video anotado: video_salida.mp4")
    print("Coordenadas del índice: coordenadas_indice.csv")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Uso: python test_hand_video.py <ruta_del_video>")
        sys.exit(1)
    main(sys.argv[1])
