import cadquery as cq
import math
from math import atan2, degrees, hypot

# =============================================================================
# CONSTANTES
# Los valores de Braille están tomados de las especificaciones de BANA
# (Guidelines and Standards for Tactile Graphics / Guidelines for Braille
# Signage): espaciado intracelda 2.3-2.5mm, diámetro de punto ~1.44mm,
# altura de punto en señalización 0.6-0.9mm, separación mínima entre
# elementos braille no relacionados 9.5mm (3/8").
# Los valores de relieve de línea/eje NO están fijados por BANA con un
# número exacto: son una elección de diseño siguiendo la práctica común de
# "jerarquía táctil" (dato > eje > marca de escala). Se recomienda validar
# el resultado impreso con un transcriptor certificado u orientador de
# movilidad antes de usarlo con fines educativos reales.
# =============================================================================

BASE_THICKNESS = 2.0

ESPACIADO_BRAILLE = 2.4
DIAM_PUNTO_BRAILLE = 1.4
CELDA_PITCH = 6.2
CLEARANCE_BRAILLE = 9.5

RELIEVE_EJE = 1.0
RELIEVE_TICK = 1.0
RELIEVE_LINEA = 1.6
DIAM_LINEA = 2.0

MARGEN_BORDE = 25.0  # margen para ejes + espacio de etiquetas braille

# --- Diccionario Braille: alfabeto grado 1 + dígitos Nemeth derivados por
#     el desplazamiento estándar (dígito n = letra n de la a-j, bajada una
#     fila) + signo numérico Nemeth (3-4-5-6) + signo menos Nemeth (3-6) ---
LETRAS = {
    'a': [1], 'b': [1, 2], 'c': [1, 4], 'd': [1, 4, 5], 'e': [1, 5],
    'f': [1, 2, 4], 'g': [1, 2, 4, 5], 'h': [1, 2, 5], 'i': [2, 4], 'j': [2, 4, 5],
    'k': [1, 3], 'l': [1, 2, 3], 'm': [1, 3, 4], 'n': [1, 3, 4, 5], 'o': [1, 3, 5],
    'p': [1, 2, 3, 4], 'q': [1, 2, 3, 4, 5], 'r': [1, 2, 3, 5], 's': [2, 3, 4],
    't': [2, 3, 4, 5], 'u': [1, 3, 6], 'v': [1, 2, 3, 6], 'w': [2, 4, 5, 6],
    'x': [1, 3, 4, 6], 'y': [1, 3, 4, 5, 6], 'z': [1, 3, 5, 6],
}
_DESPLAZAMIENTO_NEMETH = {1: 2, 2: 3, 4: 5, 5: 6}
_ORDEN_DIGITOS = list('abcdefghij')  # representan 1,2,...,9,0

BRAILLE_DICT = dict(LETRAS)
BRAILLE_DICT['numeral'] = [3, 4, 5, 6]  # indicador numérico Nemeth
BRAILLE_DICT['menos'] = [3, 6]          # signo menos Nemeth
for _n, _letra in enumerate(_ORDEN_DIGITOS, start=1):
    _digito = str(_n % 10)
    BRAILLE_DICT[_digito] = sorted(_DESPLAZAMIENTO_NEMETH[d] for d in LETRAS[_letra])


def agregar_punto_braille(modelo, cx, cy):
    """Esfera CENTRADA en la superficie superior de la placa: la mitad
    inferior queda embebida (unión booleana robusta, sin geometría
    flotante) y la mitad visible es una semiesfera de altura = radio,
    dentro del rango BANA de 0.6-0.9mm."""
    punto = (
        cq.Workplane("XY")
        .workplane(offset=BASE_THICKNESS)
        .center(cx, cy)
        .sphere(DIAM_PUNTO_BRAILLE / 2)
    )
    return modelo.union(punto)


def agregar_caracter_braille(modelo, caracter, cx, cy):
    posiciones = {
        1: (-ESPACIADO_BRAILLE / 2, ESPACIADO_BRAILLE),
        2: (-ESPACIADO_BRAILLE / 2, 0),
        3: (-ESPACIADO_BRAILLE / 2, -ESPACIADO_BRAILLE),
        4: (ESPACIADO_BRAILLE / 2, ESPACIADO_BRAILLE),
        5: (ESPACIADO_BRAILLE / 2, 0),
        6: (ESPACIADO_BRAILLE / 2, -ESPACIADO_BRAILLE),
    }
    for p in BRAILLE_DICT.get(caracter.lower(), []):
        dx, dy = posiciones[p]
        modelo = agregar_punto_braille(modelo, cx + dx, cy + dy)
    return modelo


def agregar_texto_braille(modelo, texto, cx, cy):
    """Coloca una cadena de letras braille empezando en (cx, cy), avanzando
    a la derecha celda a celda (para nombres de ejes, no para números)."""
    x = cx
    for ch in texto:
        modelo = agregar_caracter_braille(modelo, ch, x, cy)
        x += CELDA_PITCH
    return modelo


def agregar_numero_braille(modelo, valor, cx, cy):
    """Coloca un número entero (positivo o negativo) en Nemeth: signo menos
    (si corresponde) + indicador numérico + dígitos. cx/cy es la celda de
    inicio (la del signo menos si lo hay, si no la del indicador numérico)."""
    x = cx
    if valor < 0:
        modelo = agregar_caracter_braille(modelo, 'menos', x, cy)
        x += CELDA_PITCH
    modelo = agregar_caracter_braille(modelo, 'numeral', x, cy)
    x += CELDA_PITCH
    for ch in str(abs(valor)):
        modelo = agregar_caracter_braille(modelo, ch, x, cy)
        x += CELDA_PITCH
    return modelo


def agregar_segmento_relieve(modelo, p0, p1, diametro, altura):
    """Un tramo recto en relieve: un prisma orientado según p0->p1 + dos
    cilindros en los extremos. Un único conjunto de uniones por tramo, en
    vez de decenas de esferas tangentes superpuestas cada 4mm como en la
    versión original: más rápido y garantiza un sólido cerrado."""
    x0, y0 = p0
    x1, y1 = p1
    largo = hypot(x1 - x0, y1 - y0)
    if largo < 1e-6:
        return modelo
    angulo = degrees(atan2(y1 - y0, x1 - x0))
    mx, my = (x0 + x1) / 2, (y0 + y1) / 2

    cuerpo = (
        cq.Workplane("XY")
        .workplane(offset=BASE_THICKNESS)
        .center(mx, my)
        .transformed(rotate=(0, 0, angulo))
        .box(largo, diametro, altura, centered=(True, True, False))
    )
    tapa0 = (
        cq.Workplane("XY").workplane(offset=BASE_THICKNESS)
        .center(x0, y0).circle(diametro / 2).extrude(altura)
    )
    tapa1 = (
        cq.Workplane("XY").workplane(offset=BASE_THICKNESS)
        .center(x1, y1).circle(diametro / 2).extrude(altura)
    )
    return modelo.union(cuerpo).union(tapa0).union(tapa1)


def agregar_funcion(modelo, puntos, diametro=DIAM_LINEA, altura=RELIEVE_LINEA):
    """Dibuja una polilínea (recta o curva ya muestreada en puntos (x,y)
    físicos) como tramos en relieve conectados. Sirve tanto para una
    recta (2 puntos) como para cualquier función muestreada con numpy."""
    for p0, p1 in zip(puntos[:-1], puntos[1:]):
        modelo = agregar_segmento_relieve(modelo, p0, p1, diametro, altura)
    return modelo


def _valores_tick(v_min, v_max, intervalo):
    """Múltiplos de `intervalo` (incluido 0 si cae en el rango) entre
    v_min y v_max, funciona igual con v_min negativo."""
    inicio = math.ceil(v_min / intervalo) * intervalo
    valores = []
    v = inicio
    while v <= v_max:
        valores.append(int(v))
        v += intervalo
    return valores


def generar_modelo_bana(
    dim_x=210.0,   # A5 apaisado: 210 x 148 mm (cámbialo a 148x210 para vertical)
    dim_y=148.0,
    p1=(0, 0),
    p2=(150, 90),
    intervalo_ticks=25,
    archivo_salida="grafica_bana.stl",
):
    # --- Extensión de los datos. Siempre se incluye el 0 porque ahí cruzan
    #     los ejes, sin importar si p1/p2 son ambos positivos, ambos
    #     negativos o de signos distintos. ---
    xs = [0, p1[0], p2[0]]
    ys = [0, p1[1], p2[1]]
    x_min, x_max = min(xs), max(xs)
    y_min, y_max = min(ys), max(ys)

    ancho_datos = x_max - x_min
    alto_datos = y_max - y_min
    if ancho_datos > dim_x - 2 * MARGEN_BORDE or alto_datos > dim_y - 2 * MARGEN_BORDE:
        raise ValueError(
            f"Los datos (ancho={ancho_datos}mm, alto={alto_datos}mm) no entran en la "
            f"placa de {dim_x}x{dim_y}mm con un margen de {MARGEN_BORDE}mm por lado. "
            "Aumentá dim_x/dim_y, reducí MARGEN_BORDE o achicá el rango de p1/p2."
        )

    # posición física (mm sobre la placa) del punto de datos (0, 0)
    origen_x_fis = MARGEN_BORDE - x_min
    origen_y_fis = MARGEN_BORDE - y_min

    def a_fisico(punto):
        return (punto[0] + origen_x_fis, punto[1] + origen_y_fis)

    # --- 1. PLANO BASE (fondo en z=0, superficie superior en z=BASE_THICKNESS) ---
    modelo = (
        cq.Workplane("XY")
        .center(dim_x / 2, dim_y / 2)
        .box(dim_x, dim_y, BASE_THICKNESS, centered=(True, True, False))
    )

    grosor_eje = 2.0
    z_ejes = BASE_THICKNESS + RELIEVE_EJE
    z_ticks = BASE_THICKNESS + RELIEVE_TICK

    # --- 2. EJES: cubren exactamente el rango de los datos, incluido el
    #     lado negativo cuando corresponde ---
    x0_fis, x1_fis = a_fisico((x_min, 0))[0], a_fisico((x_max, 0))[0]
    y0_fis, y1_fis = a_fisico((0, y_min))[1], a_fisico((0, y_max))[1]

    eje_x = (
        cq.Workplane("XY").center((x0_fis + x1_fis) / 2, origen_y_fis)
        .box(x1_fis - x0_fis, grosor_eje, z_ejes, centered=(True, True, False))
    )
    eje_y = (
        cq.Workplane("XY").center(origen_x_fis, (y0_fis + y1_fis) / 2)
        .box(grosor_eje, y1_fis - y0_fis, z_ejes, centered=(True, True, False))
    )
    modelo = modelo.union(eje_x).union(eje_y)

    longitud_tick = 6.0

    # --- 3. TICKS + ETIQUETAS DEL EJE X (soporta valores negativos) ---
    for valor in _valores_tick(x_min, x_max, intervalo_ticks):
        x_fis = origen_x_fis + valor
        if valor != 0:
            tick = (
                cq.Workplane("XY").center(x_fis, origen_y_fis)
                .box(grosor_eje, longitud_tick, z_ticks, centered=(True, True, False))
            )
            modelo = modelo.union(tick)
        modelo = agregar_numero_braille(
            modelo, valor, cx=x_fis, cy=origen_y_fis - CLEARANCE_BRAILLE
        )

    # --- 4. TICKS + ETIQUETAS DEL EJE Y (el 0 ya quedó etiquetado junto
    #     al eje X, para no duplicarlo en el cruce) ---
    for valor in _valores_tick(y_min, y_max, intervalo_ticks):
        if valor == 0:
            continue
        y_fis = origen_y_fis + valor
        tick = (
            cq.Workplane("XY").center(origen_x_fis, y_fis)
            .box(longitud_tick, grosor_eje, z_ticks, centered=(True, True, False))
        )
        modelo = modelo.union(tick)
        ancho_estimado = CELDA_PITCH * (len(str(abs(valor))) + 2)  # signo + numeral + dígitos
        modelo = agregar_numero_braille(
            modelo, valor, cx=origen_x_fis - CLEARANCE_BRAILLE - ancho_estimado, cy=y_fis
        )

    # --- 5. NOMBRES DE LOS EJES ('x', 'y'), en el extremo positivo de cada
    #     eje, una fila más lejos que los números para no chocar con ellos ---
    modelo = agregar_texto_braille(
        modelo, 'x', cx=x1_fis - CELDA_PITCH,
        cy=origen_y_fis - CLEARANCE_BRAILLE - CELDA_PITCH * 2,
    )
    modelo = agregar_texto_braille(
        modelo, 'y', cx=origen_x_fis - CLEARANCE_BRAILLE - CELDA_PITCH * 3,
        cy=y1_fis - CELDA_PITCH,
    )

    # --- 6. FUNCIÓN / DATOS (relieve mayor que los ejes: jerarquía táctil) ---
    modelo = agregar_funcion(modelo, [a_fisico(p1), a_fisico(p2)])

    # --- 7. EXPORTAR ---
    cq.exporters.export(modelo, archivo_salida)
    print(f"Modelo táctil BANA ({dim_x}x{dim_y}mm) exportado a: {archivo_salida}")
    return modelo


if __name__ == "__main__":
    generar_modelo_bana()
