from dataclasses import dataclass
import numpy as np


@dataclass
class PrintTransform:
    """
    Cómo se convirtieron los datos originales de la gráfica a milímetros
    sobre la lámina impresa. Debe coincidir EXACTAMENTE con los
    parámetros usados al generar el STL a partir de la imagen.
    """
    x_data_min: float
    x_data_max: float
    y_data_min: float
    y_data_max: float
    plate_width_mm: float
    plate_height_mm: float
    margin_mm: float = 10.0  # margen alrededor de la gráfica en la lámina

    def data_to_mm(self, x_data, y_data):
        usable_w = self.plate_width_mm - 2 * self.margin_mm
        usable_h = self.plate_height_mm - 2 * self.margin_mm
        x_mm = self.margin_mm + (x_data - self.x_data_min) / (
            self.x_data_max - self.x_data_min) * usable_w
        # el eje y de impresión suele crecer hacia abajo; se invierte
        y_mm = self.margin_mm + (1 - (y_data - self.y_data_min) / (
            self.y_data_max - self.y_data_min)) * usable_h
        return x_mm, y_mm

    def mm_to_data_x(self, x_mm):
        usable_w = self.plate_width_mm - 2 * self.margin_mm
        frac = (x_mm - self.margin_mm) / usable_w
        return self.x_data_min + frac * (self.x_data_max - self.x_data_min)


class LineGraphLabeler:
    def __init__(self, x_data, y_data, transform: PrintTransform,
                 labels=None, tolerance_mm=4.0, unit_x="", unit_y=""):
        """
        x_data, y_data: arrays con los puntos originales de la gráfica
                        (x_data debe estar ordenado ascendente).
        labels: lista opcional de etiquetas por punto (ej. nombres de
                mes) que se usan en el texto hablado en vez del número.
        tolerance_mm: qué tan cerca debe estar el dedo de la línea
                      (en mm) para considerar que la está tocando.
        """
        self.x_data = np.asarray(x_data, dtype=float)
        self.y_data = np.asarray(y_data, dtype=float)
        self.transform = transform
        self.labels = labels
        self.tolerance_mm = tolerance_mm
        self.unit_x = unit_x
        self.unit_y = unit_y

    def read_touch(self, x_mm, y_mm):
        """
        Dado un punto físico (mm) donde se está tocando la lámina,
        devuelve un dict con la lectura, o None si no está sobre la línea.
        """
        x_query = self.transform.mm_to_data_x(x_mm)

        if x_query < self.x_data[0] or x_query > self.x_data[-1]:
            return None  # fuera del rango de la gráfica

        idx = np.searchsorted(self.x_data, x_query)
        idx = int(np.clip(idx, 1, len(self.x_data) - 1))
        x0, x1 = self.x_data[idx - 1], self.x_data[idx]
        y0, y1 = self.y_data[idx - 1], self.y_data[idx]

        frac = 0 if x1 == x0 else (x_query - x0) / (x1 - x0)
        y_line = y0 + frac * (y1 - y0)  # y interpolado de la línea en x_query

        _, y_line_mm = self.transform.data_to_mm(x_query, y_line)
        if abs(y_line_mm - y_mm) > self.tolerance_mm:
            return None  # el dedo está fuera del relieve de la línea

        # se reporta el punto de dato real más cercano (no el interpolado)
        nearest_idx = idx if (x_query - x0) > (x1 - x_query) else idx - 1
        x_val = self.x_data[nearest_idx]
        y_val = self.y_data[nearest_idx]
        label = self.labels[nearest_idx] if self.labels else None

        return {
            "index": nearest_idx,
            "x": float(x_val),
            "y": float(y_val),
            "label": label,
            "text": self._to_speech_text(x_val, y_val, label),
        }

    def _to_speech_text(self, x_val, y_val, label):
        x_part = label if label else f"{x_val:g}{self.unit_x}"
        return f"{x_part}: {y_val:g}{self.unit_y}"